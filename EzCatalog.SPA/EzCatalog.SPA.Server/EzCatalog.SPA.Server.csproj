<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EzCatalog.SPA.Server</RootNamespace>
    <SpaRoot>..\ezcatalog-spa\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <Target Name="BuildSpa" BeforeTargets="BeforeBuild"
          Condition="'$(SkipSpaBuild)' != 'true' And ('$(_IsPublishing)' == 'true' Or !Exists('$(MSBuildProjectDirectory)\wwwroot\index.html'))">
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

</Project>
